# Server-only. Set these in Vercel, not in a file that ships to the browser.
# Never prefix them with VITE_: Vite would bake the value into the public bundle.

# Notion integration token for the function in api/lead.js.
NOTION_TOKEN=

# Optional. Defaults to the NotionOS People and Opportunities databases.
# NOTION_PEOPLE_DATABASE_ID=
# NOTION_OPPORTUNITIES_DATABASE_ID=
